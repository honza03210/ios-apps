<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NFC tag reading. Automatic signing with -allowProvisioningUpdates
	     registers this capability on the App ID for the TestFlight build.
	     (Free-provisioning / AltStore sideloads can't grant it, so the NFC
	     demo simply reports "unavailable" there — every other demo works.) -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
		<string>TAG</string>
	</array>
</dict>
</plist>
